{
  "name": "@parallaxai/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Parallax platform",
  "bin": {
    "parallax": "./dist/index.js",
    "parallax-dev": "./bin/parallax-dev.ts"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "parallax-dev": "tsx bin/parallax-dev.ts",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "dependencies": {
    "@parallaxai/control-plane": "workspace:*",
    "@parallaxai/data-plane": "workspace:*",
    "@parallaxai/runtime": "workspace:*",
    "axios": "^1.20.0",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "inquirer": "^12.11.1",
    "js-yaml": "^4.3.2",
    "ora": "^8.2.0",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "table": "^6.9.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.1",
    "@types/ws": "^8.5.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
