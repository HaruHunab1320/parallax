{
  "name": "@parallaxai/telemetry",
  "version": "0.1.0",
  "description": "OpenTelemetry instrumentation for Parallax platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
