{
  "name": "@parallaxai/sdk-typescript",
  "version": "0.4.0",
  "description": "TypeScript SDK for Parallax AI orchestration platform",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "clean": "rm -rf dist generated",
    "lint": "eslint src && buf lint",
    "type-check": "tsc --noEmit",
    "generate": "./generate-proto.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^1.10.1",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.7.15",
    "@parallaxai/confidence": "workspace:*",
    "google-protobuf": "^3.21.4",
    "pino": "^9.14.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.50.0",
    "@protobuf-ts/plugin": "^2.11.1",
    "@protobuf-ts/protoc": "^2.11.1",
    "@types/google-protobuf": "^3.15.12",
    "@types/node": "^22.14.1",
    "@types/pino": "^7.0.5",
    "@types/uuid": "^10.0.0",
    "grpc-tools": "^1.12.4",
    "grpc_tools_node_protoc_ts": "^5.3.3",
    "ts-proto": "^2.7.5",
    "typescript": "^5.9.3",
    "vitest": "^2.1.7"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "files": [
    "dist",
    "proto",
    "generated"
  ],
  "publishConfig": {
    "access": "public"
  }
}
